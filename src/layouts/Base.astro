---
import { site, href } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Fontu ?url ile aliyoruz ki Vite'in urettigi HASHLI adresi elimize gecsin.
// Duz '/fonts/...' yazmak calismiyordu: fontlar public/ degil src/ altinda,
// yani dist'te /_astro/fraunces-....woff2 olarak cikiyorlar.
import fontLatinExt from '../fonts/fraunces-latinext.woff2?url';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Tekil yazi sayfalarinda arama motoruna "bu bir makale" demek icin */
  article?: { date: Date; modified?: Date; tags?: string[] };
  image?: string;
  noindex?: boolean;
  /** Sayfanin dili. Ingilizce yazilarda 'en'. */
  lang?: 'tr' | 'en';
}

const { title, description, article, image, noindex = false, lang = 'tr' } = Astro.props;
const locale = lang === 'en' ? 'en_US' : site.locale;

const pageTitle = title ? `${title} - ${site.title}` : `${site.title} - ${site.tagline}`;
const desc = (description || site.description).slice(0, 200);
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const ogImage = image ? new URL(image, canonical).toString() : undefined;

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description: desc,
      datePublished: article.date.toISOString(),
      dateModified: (article.modified ?? article.date).toISOString(),
      author: { '@type': 'Person', name: site.author },
      inLanguage: lang,
      mainEntityOfPage: canonical,
      ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
      ...(ogImage ? { image: ogImage } : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      name: site.title,
      description: desc,
      inLanguage: site.lang,
      url: canonical,
      author: { '@type': 'Person', name: site.author },
    };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/*
      Google Analytics 4. is:inline SART: Astro normalde <script> etiketlerini
      toplayip kendi paketine katiyor; ucuncu taraf betigi oldugu gibi
      basilmali. Kimlik site.ts'te; orayi bosaltirsan burasi hic basilmaz.
    */}
    {site.googleAnalytics && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.googleAnalytics}`}></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${site.googleAnalytics}');
        `}></script>
      </>
    )}

    {/*
      Ziyaret sayaci. Analytics paneline yalniz sahibi bakabiliyor; bu sayaclar
      herkese acik okunuyor, boylece "giren var mi" sorusu bir betikle
      cevaplanir (scripts/sayac-oku.mjs). Servis hesapsiz ve ucretsiz
      (abacus.jasoncameron.dev); 6 ay hic sayilmayan anahtar silinir.
      Cerez yok, kisisel veri yok: yalniz uc sayac artiyor.
        g-YYYY-MM-DD  o gunun sayfa goruntulemesi
        t-YYYY-MM-DD  o gunun tekil ziyaretcisi (tarayici basina gunde bir)
        s-<adres>     sayfa basina toplam
      Yalniz gercek adreste sayar: onizleme, yerel derleme ve otomatik
      tarayicilar (navigator.webdriver) sayilmaz.
    */}
    <script is:inline set:html={`
      (function () {
        try {
          if (location.hostname !== '${Astro.site?.hostname ?? ''}' || navigator.webdriver) return;
          var ns = 'alperalyaz-blog';
          var gun = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Istanbul' }).format(new Date());
          var yol = location.pathname.replace(/^\\/+|\\/+$/g, '').toLowerCase()
            .replace(/[^a-z0-9-]+/g, '-').slice(0, 60) || 'anasayfa';
          var vur = function (k) {
            fetch('https://abacus.jasoncameron.dev/hit/' + ns + '/' + k, { keepalive: true }).catch(function () {});
          };
          vur('g-' + gun);
          vur('s-' + yol);
          var isaret = null;
          try { isaret = localStorage.getItem('sayac-gun'); } catch (e) {}
          if (isaret !== gun) {
            vur('t-' + gun);
            try { localStorage.setItem('sayac-gun', gun); } catch (e) {}
          }
        } catch (e) {}
      })();
    `}></script>

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={locale} />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={title ?? site.title} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf8f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#100f0c" />

    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('/rss.xml')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={fontLatinExt} as="font" type="font/woff2" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik" class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
