---
/**
 * YORUMLAR — giscus (GitHub Discussions tabanli).
 *
 * Neden bu: yorumlar bu deponun kendi Discussions bolumunde durur. Ucuncu bir
 * sirkette degil, blogun yanindadir; blog tasinirsa yorumlar da gelir. Bedava,
 * reklamsiz, takip kodsuz. Bedeli: yorum yazan kisinin GitHub hesabi olmali.
 *
 * Betik `async` ve `data-loading="lazy"` ile yuklenir: sayfa acilirken degil,
 * okur asagi inip yorum bolumune gelince istek gider. Yani sayfa hizina etkisi
 * yok.
 *
 * Kurulum yarimsa (kategoriId bos) HICBIR SEY basilmaz - bkz. site.ts.
 */
import { site } from '../lib/site';
const y = site.yorumlar;
const acik = Boolean(y?.kategoriId);
---
{acik && (
  <section class="yorumlar prose" aria-label="Yorumlar">
    <h2 class="yorum-baslik">Yorumlar</h2>
    <p class="yorum-not">
      Yorum yazmak için GitHub hesabı gerekiyor. Hesabın yoksa
      <a href="/hakkinda/">hakkımda sayfasından</a> da ulaşabilirsin.
    </p>
    <script
      src="https://giscus.app/client.js"
      data-repo={y.depo}
      data-repo-id={y.depoId}
      data-category={y.kategori}
      data-category-id={y.kategoriId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang="tr"
      data-loading="lazy"
      crossorigin="anonymous"
      async
      is:inline
    ></script>
  </section>
)}
