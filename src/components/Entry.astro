---
import { href, trDate, isoDate } from '../lib/site';
import { linkedTags } from '../lib/tags';

interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  /** Defter kaydi numarasi - en eski yazi 001. */
  num?: number;
}
const { slug, title, date, description = '', tags = [], num } = Astro.props;
const linked = await linkedTags();
---
<article class="entry">
  <div class="entry-num">{num !== undefined ? String(num).padStart(3, '0') : ''}</div>
  <div>
    <h2 class="entry-title"><a href={href(`/${slug}/`)}>{title}</a></h2>
    {description && <p class="entry-desc">{description}</p>}
    <div class="meta">
      <time datetime={isoDate(date)}>{trDate(date)}</time>
      {tags.slice(0, 3).map(t => (
        linked.has(t)
          ? <a href={href(`/etiket/${encodeURIComponent(t)}/`)}>#{t}</a>
          : <span>#{t}</span>
      ))}
    </div>
  </div>
</article>
