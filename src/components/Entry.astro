---
import { href, trDate, isoDate } from '../lib/site';
import { linkedTags } from '../lib/tags';
import { kucukKapak } from '../lib/kapak';

interface Props {
  slug: string;
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  cover?: string;
  /** Yazinin dili; Turkce disindaysa listede rozet gosterilir. */
  lang?: 'tr' | 'en';
  /** Defter kaydi numarasi - en eski yazi 001. */
  num?: number;
}
const { slug, title, date, description = '', tags = [], cover, lang = 'tr', num } = Astro.props;
const linked = await linkedTags();
const thumb = kucukKapak(cover);
---
<article class:list={['entry', thumb && 'has-thumb']}>
  <div class="entry-num">{num !== undefined ? String(num).padStart(3, '0') : ''}</div>

  <div class="entry-main">
    <h2 class="entry-title"><a href={href(`/${slug}/`)}>{title}</a></h2>
    {description && <p class="entry-desc">{description}</p>}
    <div class="meta">
      <time datetime={isoDate(date)}>{trDate(date)}</time>
      {lang !== 'tr' && <span class="dil" title="Bu yazı İngilizce">{lang.toUpperCase()}</span>}
      {tags.slice(0, 3).map(t => (
        linked.has(t)
          ? <a href={href(`/etiket/${encodeURIComponent(t)}/`)}>#{t}</a>
          : <span>#{t}</span>
      ))}
    </div>
  </div>

  {thumb && (
    <a class="entry-thumb" href={href(`/${slug}/`)} tabindex="-1" aria-hidden="true">
      <img src={href(thumb)} alt="" width="300" height="225" loading="lazy" decoding="async" />
    </a>
  )}
</article>
