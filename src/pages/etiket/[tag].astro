---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { MIN_TAG_POSTS, etiketSlug } from '../../lib/tags';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const map = new Map<string, typeof posts>();
  for (const p of posts) {
    for (const t of p.data.tags) {
      if (!map.has(t)) map.set(t, []);
      map.get(t)!.push(p);
    }
  }
  return [...map.entries()]
    .filter(([, items]) => items.length >= MIN_TAG_POSTS)
    .map(([tag, items]) => ({
      // Adres ASCII slug; ekranda gorunen ad props ile tasiniyor.
      params: { tag: etiketSlug(tag) },
      props: { tag, items: items.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) },
    }));
}

const { tag, items } = Astro.props;
---
<Base title={`#${tag}`} description={`"${tag}" etiketli ${items.length} yazı.`}>
  <h1 class="post-title">#{tag}</h1>
  <p class="intro">{items.length} yazı.</p>
  {items.map(p => (
    <Entry slug={p.id} title={p.data.title} date={p.data.date}
           description={p.data.description} tags={p.data.tags} cover={p.data.cover} lang={p.data.lang} />
  ))}
</Base>
