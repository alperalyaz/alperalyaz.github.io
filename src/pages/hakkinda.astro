---
/**
 * Hakkinda sayfasi. METIN BURADA DEGIL: src/content/sayfa/hakkinda.md
 * dosyasindan okunuyor, boylece /admin/ panelinden duzenlenebiliyor.
 * Bu dosya yalnizca duzeni kurar; yazi, portre ve fotograflar icerikten gelir.
 */
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';

const sayfa = await getEntry('sayfa', 'hakkinda');
if (!sayfa) throw new Error('src/content/sayfa/hakkinda.md bulunamadi');
const { Content } = await render(sayfa);
const d = sayfa.data;
const fotograflar = d.fotograflar.filter(f => f.gorsel);
---
<Base title={d.title} description={d.description} image={d.portre || undefined}>
  <h1 class="post-title">{d.title}</h1>

  {d.portre && (
    <figure class="portre">
      <img src={href(d.portre)} alt={d.portreAciklama || 'Alper Alyaz'} loading="eager" />
      {d.portreAciklama && <figcaption>{d.portreAciklama}</figcaption>}
    </figure>
  )}

  <div class="post-body prose">
    <Content />
  </div>

  {fotograflar.length > 0 && (
    <div class="foto-serit">
      {fotograflar.map(f => (
        <figure>
          <img src={href(f.gorsel)} alt={f.aciklama} loading="lazy" decoding="async" />
          {f.aciklama && <figcaption>{f.aciklama}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</Base>
