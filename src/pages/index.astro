---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { site, href } from '../lib/site';

/* Ana sayfada kac yazi gorunsun?
   Tamami burada listelenince sayfa 2011'e kadar iniyordu ve kimse
   o kadar asagi inmiyor. Gerisi arsivde - orada tek satirlik
   kayitlar halinde, yillara bolunmus olarak duruyor. */
const SON_YAZI = 15;

const hepsi = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Defter numarasi tum arsive gore verilir (en eski 001), kesilse bile degismez.
const numOf = new Map(hepsi.map((p, i) => [p.id, hepsi.length - i]));

const posts = hepsi.slice(0, SON_YAZI);
const kalan = hepsi.length - posts.length;

const byYear: Array<[string, typeof posts]> = [];
for (const p of posts) {
  const y = String(p.data.date.getFullYear());
  const last = byYear.at(-1);
  if (last && last[0] === y) last[1].push(p);
  else byYear.push([y, [p]]);
}
---
<Base>
  <p class="intro">{site.description}</p>

  {byYear.map(([year, items]) => (
    <section>
      <div class="year-head">
        <span class="year-num">{year}</span>
        <span class="year-note">{items.length} yazı</span>
      </div>
      {items.map(p => (
        <Entry
          slug={p.id}
          num={numOf.get(p.id)}
          title={p.data.title}
          date={p.data.date}
          description={p.data.description}
          tags={p.data.tags}
          cover={p.data.cover}
          lang={p.data.lang}
        />
      ))}
    </section>
  ))}

  {kalan > 0 && (
    <a class="hepsi" href={href('/arsiv/')}>
      <span class="hepsi-sayi">{kalan}</span>
      <span class="hepsi-metin">
        yazı daha var — {hepsi[hepsi.length - 1].data.date.getFullYear()} yılına kadar
        <strong>Arşivin tamamı →</strong>
      </span>
    </a>
  )}
</Base>
